{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sethyrung/dotfiles/dotfiles.schema.json",
  "title": "Dotfiles Configuration",
  "description": "Configuration schema for dotfiles bootstrap presets",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative or absolute URI to the dotfiles configuration JSON Schema"
    },
    "tools": {
      "type": "object",
      "description": "Enable or disable installation of specific tools and components",
      "properties": {
        "ghostty": {
          "type": "boolean",
          "description": "Enable or disable Ghostty terminal installation"
        },
        "zed": {
          "type": "boolean",
          "description": "Enable or disable Zed editor installation"
        },
        "skills": {
          "type": "boolean",
          "description": "Enable or disable agent skills installation"
        },
        "piPackages": {
          "type": "boolean",
          "description": "Enable or disable pi extensions installation"
        },
        "omzPlugins": {
          "type": "boolean",
          "description": "Enable or disable Oh My Zsh plugins cloning"
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "description": "Agent skills to install (e.g. owner/repo@skill)",
      "items": {
        "type": "string"
      }
    },
    "piPackages": {
      "type": "array",
      "description": "pi extensions to install",
      "items": {
        "type": "string"
      }
    },
    "omzPlugins": {
      "type": "array",
      "description": "Oh My Zsh plugins to clone",
      "items": {
        "type": "string"
      }
    },
    "packages": {
      "description": "Distro packages required by the workflow",
      "oneOf": [
        {
          "type": "array",
          "description": "Distro-agnostic list of package names",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Mapping of package manager to package names",
          "properties": {
            "apt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pacman": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dnf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "zypper": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "apiKeys": {
      "type": "array",
      "description": "Expected API Key names (identifiers only, never values)",
      "items": {
        "type": "string"
      }
    },
    "mcp": {
      "type": "object",
      "description": "Canonical MCP server list. Each additional property is a server name mapped to a remote url or a local command.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "description": "Remote MCP server",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "HTTPS URL of the MCP server"
              }
            },
            "required": ["url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "Local stdio MCP server",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Executable to launch"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the executable",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["command"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
